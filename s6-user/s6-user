#!/bin/sh

# Run s6-frontend with the fixed per-user repository and service-store policy.

set -eu

fail()
{
    echo "s6-user: $*" >&2
    exit 70
}

uid=$(id -u) || fail "unable to determine uid"

if [ -z "${HOME-}" ] || [ ! -d "$HOME" ]; then
    HOME=$(getent passwd "$uid" | awk -F: 'NR == 1 { print $6 }')
fi

case ${HOME-} in
    /*) ;;
    *) fail "HOME is not an absolute directory" ;;
esac

xdg_default()
{
    case $1 in
        /*) printf '%s\n' "$1" ;;
        *) printf '%s/%s\n' "$HOME" "$2" ;;
    esac
}

XDG_CONFIG_HOME=$(xdg_default "${XDG_CONFIG_HOME-}" .config)
XDG_DATA_HOME=$(xdg_default "${XDG_DATA_HOME-}" .local/share)
XDG_STATE_HOME=$(xdg_default "${XDG_STATE_HOME-}" .local/state)
XDG_CACHE_HOME=$(xdg_default "${XDG_CACHE_HOME-}" .cache)
case ${XDG_RUNTIME_DIR-} in
    /*) ;;
    *) XDG_RUNTIME_DIR="/run/user/$uid" ;;
esac

# The store list is colon-separated, and `version export` is line-based.
case $XDG_CONFIG_HOME in
    *:*) fail "XDG_CONFIG_HOME must not contain ':'" ;;
esac
newline='
'
case "$HOME$XDG_CONFIG_HOME$XDG_DATA_HOME$XDG_STATE_HOME$XDG_CACHE_HOME$XDG_RUNTIME_DIR" in
    *"$newline"*) fail "HOME and XDG paths must not contain newlines" ;;
esac

export HOME XDG_CONFIG_HOME XDG_DATA_HOME XDG_STATE_HOME XDG_CACHE_HOME XDG_RUNTIME_DIR

scandir="$XDG_RUNTIME_DIR/service"
livedir="$XDG_RUNTIME_DIR/s6-rc"
repo="$XDG_STATE_HOME/s6-rc/repository"
bootdb="$XDG_CONFIG_HOME/s6-rc/compiled/current"
stmpdir="$XDG_RUNTIME_DIR/s6-frontend"
user_store="$XDG_CONFIG_HOME/s6-rc/sources"
storelist="/usr/share/s6-rc/user/sources:/etc/s6-rc/user/sources:$user_store"

umask 077
mkdir -p \
    "$user_store" \
    "$XDG_STATE_HOME/s6-rc" \
    "$XDG_CONFIG_HOME/s6-rc/compiled"

# Explicit options keep command-line policy authoritative over both the system
# frontend configuration and s6-frontend's built-in user defaults. An empty
# fdholder user leaves the internal fd-holder running as the s6-svscan user.
exec s6 \
    --user \
    --verbosity=1 \
    --scandir="$scandir" \
    --livedir="$livedir" \
    --repodir="$repo" \
    --bootdb="$bootdb" \
    --stmpdir="$stmpdir" \
    --storelist="$storelist" \
    --fdholder-user= \
    "$@"
