pkgname=turnstile-backend-s6
pkgver=0.1.0
pkgrel=1
pkgdesc='Turnstile backend for per-user s6-svscan and s6-rc'
arch=('any')
url='https://github.com/artix-s6-user/artix-s6-user'
license=('0BSD')
depends=('turnstile' 's6-user')
source=('backend-s6' 'LICENSE')
sha256sums=('dae5467cf7c3817e2f17120867145b4f4687434af8b090b9710d24d7ff74c3d0'
            'e43689ed5dbd460be77c4f8ecc14a1285671194f11f711520a7be8d8d6d847f7')

package() {
    # Artix's Turnstile package compiles LIBEXEC_PATH as /usr/lib/turnstile.
    install -Dm755 backend-s6 "$pkgdir/usr/lib/turnstile/s6"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
