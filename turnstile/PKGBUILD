# Adapted from https://gitea.artixlinux.org/packages/turnstile.git.
# The dinit split package and runit backend are intentionally omitted here.
# Contributor: Muhammad Herdiansyah <koni@artixlinux.org>
pkgname=turnstile
pkgver=0.1.11.r2
pkgrel=1
pkgdesc='PAM session tracker and user service-manager launcher'
arch=('x86_64')
url='https://github.com/username13121/turnstile'
license=('BSD-2-Clause')
depends=('pam' 'elogind')
makedepends=('meson' 'scdoc')
backup=('etc/turnstile/turnstiled.conf')
options=('!debug')
_commit=75b980edba8b7bb332f0ae936a1a9bb0917521b5
source=("$pkgname-$_commit.tar.gz::$url/archive/$_commit.tar.gz")
sha256sums=('68dbe05f79b1a2126de8d8c244599eb53953f345d705bf4b6dfc0c8dc5dccbd6')

build() {
    meson setup build "$pkgname-$_commit" \
        --prefix=/usr \
        --sbindir=bin \
        --libexecdir=lib \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --buildtype=plain \
        --wrap-mode=nodownload \
        -Ddinit=disabled \
        -Drunit=disabled \
        -Ddefault_backend=none \
        -Dmanage_rundir=false \
        -Dpamdir=/etc/pam.d \
        -Dpam_moddir=/usr/lib/security
    meson compile -C build
}

package() {
    meson install -C build --destdir "$pkgdir"
    install -Dm644 "$pkgname-$_commit/COPYING.md" \
        "$pkgdir/usr/share/licenses/$pkgname/COPYING.md"
}
